<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest ExtensionBundleId="com.ugui.rename"
  ExtensionBundleVersion="1.0.0"
  Version="10.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.ugui.rename.panel" Version="1.0.0"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PHSP" Version="19.0"/> <!-- PHSP 代表 Photoshop -->
      <Host Name="PHXS" Version="19.0"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="10.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.ugui.rename.panel">
      <DispatchInfo>
        <Resources>
          <!-- 指定前端HTML界面 -->
          <MainPath>./client/index.html</MainPath>
          <!-- 指定后端JSX脚本 -->
          <ScriptPath>./host/UGUI_Rename.jsx</ScriptPath>
        </Resources>
        <Lifecycle>
          <!-- 插件启动时自动显示 -->
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <!-- 面板类型 -->
          <Type>Panel</Type>
          <!-- 在菜单中显示的名称 -->
          <Menu>UGUI 图层命名工具</Menu>
          <Geometry>
            <Size>
              <!-- 面板初始大小 -->
              <Height>450</Height>
              <Width>280</Width>
            </Size>
          </Geometry>
          <!-- 面板图标（可选） -->
          <Icon>./img/icon.png</Icon>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>